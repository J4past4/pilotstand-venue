# =============================================================================
# Zuki — Exhibition Planner (AI Designer) — Server Environment Variables (Vercel)
# NEVER prefix secret API keys with VITE_ (they must stay server-side only).
# =============================================================================

# 1. Choose active AI provider: gemini | anthropic | openai
#    (If omitted, auto-detects from whichever API key below is set)
AI_PROVIDER=gemini

# Optional: override the default model for the chosen provider
#   gemini default:    gemini-2.5-flash-lite   (~$0.0004/prompt, native voice!)
#   anthropic default: claude-haiku-5-5        (~$0.0005/prompt)
#   openai default:    gpt-5.4-nano            (~$0.0010/prompt)
# AI_MODEL=gemini-2.5-flash-lite

# 2. Provider API Keys (configure at least one)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# 3. Anti-Shock-Bill Guardrails & Rate Limits
AI_RATE_LIMIT_HOURLY=20
AI_RATE_LIMIT_DAILY=50
# Hard global daily cap across all visitors (e.g., 1500 prompts ~= $0.60-$1.50/day)
AI_GLOBAL_DAILY_CAP=1500
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_PROMPT_CHARS=1000
AI_MAX_AUDIO_SECONDS=32

# 4. Distributed Rate Limiting (Recommended for Production on Vercel)
#    Free tier at https://upstash.com — works across serverless cold starts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 5. Optional Security Hardening
#    Comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=https://your-domain.vercel.app
#    Cloudflare Turnstile secret key (optional bot protection)
# TURNSTILE_SECRET_KEY=

# 6. Access Mode: Public Launch vs. Private Beta (Vercel Server-Side Only)
#    Choose how visitors access the planner:
#      - APP_ACCESS_MODE=public  -> Open 3D sandbox for everyone + free Public Launch signup form
#                                   (soft-gated on exports/saves), Supplier Partner application form,
#                                   BOM Quote Requests, and Founder Launch Insights dashboard.
#      - APP_ACCESS_MODE=beta    -> Invite-only Private Beta login wall (default when BETA_USERS
#                                   or BETA_INVITE_CODE is set without APP_ACCESS_MODE=public).
# APP_ACCESS_MODE=public
#
#    A) Durable Storage (Required for Vercel production signups, supplier inquiries & metrics):
#       Connect Upstash Redis in Vercel Storage (auto-sets UPSTASH_REDIS_REST_* or KV_REST_API_*).
#
#    B) Private Beta Invite-Only Self-Signup (used when APP_ACCESS_MODE=beta):
#       Tip: Share `https://your-app.vercel.app/?invite=ZUKI-BETA-2026` to pre-fill the invite code!
# BETA_INVITE_CODE=ZUKI-BETA-2026
#       Optional: restrict private beta sign-ups to specific emails or your company email domain
# BETA_ALLOWED_EMAILS=marketer@company.com
# BETA_ALLOWED_DOMAINS=company.com
#
#    C) Pre-seeded Admin Account (recommended in BOTH public and beta modes — unlocks the
#       Founder "Insights" dashboard & CSV lead export for registered users, suppliers, and RFQs):
# BETA_USERS=[{"email":"you@company.com","name":"James","role":"admin","password":"replace-with-strong-password"}]
#
#    Strong random secret for signing HttpOnly session cookies (generate with `openssl rand -hex 32`)
# AUTH_SESSION_SECRET=


